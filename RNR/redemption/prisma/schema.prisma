generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(cuid())
  createdAt           DateTime      @default(now())
  email               String        @unique
  password            String
  salt                String
  name                String?
  twoFactorAuth       Boolean       @default(false)
  twoFactorSecret     String?
  credits             Int           @default(0)
  isActive            Boolean       @default(true)
  role                UserRole      @default(USER)
  resetToken          String?
  Post                Post?
  TransactionsAsBuyer Transaction[] @relation("Buyer")
  TransactionAsSeller Transaction[] @relation("Seller")
}

model Post {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  type        ItemType     @default(Plastic_Bottles)
  desc        String       @default("")
  isApproved  Boolean      @default(false)
  authorId    String       @unique
  isAvailable Boolean      @default(true)
  quantity    Int          @default(0)
  imagePath   String       @default("https://example.com/default-image.png")
  itemCredits Int          @default(0)
  location    String       @default("")
  Author      User         @relation(fields: [authorId], references: [id])
  Transaction Transaction? @relation("post")
}

model Transaction {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  postId        String   @unique
  buyerId       String
  sellerId      String
  agreedCredits Int      @default(0)
  isCompleted   Boolean  @default(false)
  buyerAgreed   Boolean  @default(false)  
  sellerAgreed  Boolean  @default(false)
  Buyer         User     @relation("Buyer", fields: [buyerId], references: [id])
  Post          Post     @relation("post", fields: [postId], references: [id])
  Seller        User     @relation("Seller", fields: [sellerId], references: [id])
}

enum UserRole {
  ADMIN
  USER
}

enum ItemType {
  Plastic_Bottles
  Aluminum_Cans
  Paper
  Glass_Bottles
  Electronics
  Textiles
  Batteries
  Metal_Scrap
}
